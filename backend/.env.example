NODE_ENV=development
PORT=3000
SWAGGER_ENABLED=true

POSTGRES_USER=conecta
POSTGRES_PASSWORD=coloque_sua_senha_local_aqui
POSTGRES_DB=conecta_service

DATABASE_URL="postgresql://conecta:SUA_SENHA@127.0.0.1:5433/conecta_service?schema=public"

# Origens web permitidas, separadas por vírgula.
# Deixe vazio enquanto não houver frontend.
CORS_ORIGINS=

# Gere o segredo com:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=900